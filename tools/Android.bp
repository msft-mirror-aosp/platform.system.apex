package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

python_binary_host {
    name: "apex_fix",
    srcs: [
        "apex_fix.py",
    ],
}

python_test_host {
    name: "apex_fix_test",
    main: "apex_fix_test.py",
    srcs: [
        "apex_fix.py",
        "apex_fix_test.py",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}

python_binary_host {
    name: "deapexer",
    srcs: [
        "deapexer.py",
    ],
    libs: [
        "apex_manifest",
    ],
    required: [
        "debugfs_static", // "debugfs" fails with BUILD_HOST_static=1
        "fsck.erofs",
    ],
}

python_binary_host {
    name: "apex_elf_checker",
    srcs: [
        "apex_elf_checker.py",
    ],
    required: [
        "deapexer",
    ],
}

python_binary_host {
    name: "apex_compression_tool",
    srcs: [
        "apex_compression_tool.py",
    ],
    libs: [
        "apex_manifest_proto",
    ],
    required: [
        "avbtool",
        "conv_apex_manifest",
    ],
}

python_test_host {
    name: "apex_compression_test",
    pkg_path: "apex_compression_test",
    main: "apex_compression_test.py",
    srcs: [
        "apex_compression_test.py",
    ],
    data: [
        ":avbtool",
        ":conv_apex_manifest",
        ":apex_compression_tool",
        ":deapexer",
        ":soong_zip",
    ],
    device_common_data: [
        ":com.android.example.apex",
    ],
    libs: [
        "apex_manifest_proto",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}

cc_binary_host {
    name: "host_apex_verifier",
    srcs: ["host_apex_verifier.cc"],
    defaults: [
        "init_host_defaults",
        "libapex-deps",
    ],
    static_libs: [
        "libapex",
        "libinit_host",
    ],
    // Choose one protobuf library to avoid ODR:
    // - libapex-deps brings "full" as shared
    // - init_host_defaults brings "lite" as shared
    exclude_shared_libs: [
        "libprotobuf-cpp-lite",
    ],
    required: [
        "deapexer",
    ],
}

python_library_host {
    name: "apexer_wrapper_utils",
    srcs: ["apexer_wrapper_utils.py"],
}

python_binary_host {
    name: "apexer_with_trim_preprocessing",
    srcs: [
        "apexer_with_trim_preprocessing.py",
    ],
    libs: [
        "apex_manifest_proto",
        "apexer_wrapper_utils",
    ],
}

python_binary_host {
    name: "apexd_host",
    srcs: ["apexd_host.py"],
    libs: [
        "apex_manifest",
    ],
    required: [
        "deapexer",
        "debugfs",
        "fsck.erofs",
    ],
}

python_binary_host {
    name: "brand_new_apex_verifier",
    srcs: ["brand_new_apex_verifier.py"],
    libs: [
        "apex_blocklist_proto",
    ],
}

sh_binary {
    name: "apexd-lsof.sh",
    src: "apexd-lsof.sh",
}

genrule {
    name: "static_apexer_tools",
    tools: [
        ":soong_zip",
        "signapk",
        ":aapt2",
        ":apexer",
        ":avbtool",
        ":deapexer",
        ":debugfs_static",
        ":blkid_static",
        ":e2fsdroid",
        ":fsck.erofs",
        ":mkfs.erofs",
        ":merge_zips",
        ":mke2fs",
        ":resize2fs",
        ":sefcontext_compile",
        ":zipalign",
    ],
    out: [
        "signapk.jar",
        "libconscrypt_openjdk_jni.so",
        "aapt2",
        "apexer",
        "avbtool",
        "deapexer",
        "debugfs_static",
        "blkid_static",
        "e2fsdroid",
        "fsck.erofs",
        "mkfs.erofs",
        "merge_zips",
        "mke2fs",
        "resize2fs",
        "sefcontext_compile",
        "soong_zip",
        "zipalign",
    ],
    cmd: select(soong_config_variable("ANDROID", "BUILD_HOST_static"), {
        true: "HOST_OUT_BIN=$$(dirname $(location :soong_zip)) && " +
            "HOST_SOONG_OUT=$$(dirname $$(dirname $$HOST_OUT_BIN)) && " +
            "SIGNAPK_JAR=$$(find $$HOST_SOONG_OUT -name \"signapk*\") && " +
            "LIBCONSCRYPT_OPENJDK_JNI=$$(find $$HOST_SOONG_OUT -name \"libconscrypt_openjdk_jni.*\") && " +
            "cp $${SIGNAPK_JAR} $(genDir) && " +
            "cp $${LIBCONSCRYPT_OPENJDK_JNI} $(genDir) && " +
            "cp $${HOST_OUT_BIN}/* $(genDir)",
        default: "echo \"You must export BUILD_HOST_static to build static_apexer_tools.\" >&2 && exit 1",
    }),
    dist: {
        dir: "static_apexer_tools",
        targets: ["static_apexer_tools"],
    },
    // The error message if BUILD_HOST_static is not set will cause checkbuilds to fail,
    // so skip this module on checkbuild.
    unchecked_module: true,
}
