package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

python_binary_host {
    name: "apex_fix",
    srcs: [
        "apex_fix.py",
    ],
}

python_test_host {
    name: "apex_fix_test",
    main: "apex_fix_test.py",
    srcs: [
        "apex_fix.py",
        "apex_fix_test.py",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}

python_binary_host {
    name: "deapexer",
    srcs: [
        "deapexer.py",
    ],
    libs: [
        "apex_manifest",
    ],
    required: [
        "debugfs_static", // "debugfs" fails with BUILD_HOST_static=1
        "fsck.erofs",
    ],
}

python_binary_host {
    name: "apex_elf_checker",
    srcs: [
        "apex_elf_checker.py",
    ],
    required: [
        "deapexer",
    ],
}

python_binary_host {
    name: "apex_compression_tool",
    srcs: [
        "apex_compression_tool.py",
    ],
    libs: [
        "apex_manifest_proto",
    ],
    required: [
        "avbtool",
        "conv_apex_manifest",
    ],
}

python_test_host {
    name: "apex_compression_test",
    pkg_path: "apex_compression_test",
    main: "apex_compression_test.py",
    srcs: [
        "apex_compression_test.py",
    ],
    data: [
        ":avbtool",
        ":conv_apex_manifest",
        ":apex_compression_tool",
        ":deapexer",
        ":soong_zip",
    ],
    device_common_data: [
        ":com.android.example.apex",
    ],
    libs: [
        "apex_manifest_proto",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}

cc_binary_host {
    name: "host_apex_verifier",
    srcs: ["host_apex_verifier.cc"],
    defaults: [
        "init_host_defaults",
        "libapex-deps",
    ],
    static_libs: [
        "libapex",
        "libinit_host",
    ],
    // Choose one protobuf library to avoid ODR:
    // - libapex-deps brings "full" as shared
    // - init_host_defaults brings "lite" as shared
    exclude_shared_libs: [
        "libprotobuf-cpp-lite",
    ],
    required: [
        "deapexer",
    ],
}

python_library_host {
    name: "apexer_wrapper_utils",
    srcs: ["apexer_wrapper_utils.py"],
}

python_binary_host {
    name: "apexer_with_trim_preprocessing",
    srcs: [
        "apexer_with_trim_preprocessing.py",
    ],
    libs: [
        "apex_manifest_proto",
        "apexer_wrapper_utils",
    ],
}

python_binary_host {
    name: "apexd_host",
    srcs: ["apexd_host.py"],
    libs: [
        "apex_manifest",
    ],
    required: [
        "deapexer",
        "debugfs",
        "fsck.erofs",
    ],
}

python_binary_host {
    name: "brand_new_apex_verifier",
    srcs: ["brand_new_apex_verifier.py"],
    libs: [
        "apex_blocklist_proto",
    ],
}

sh_binary {
    name: "apexd-lsof.sh",
    src: "apexd-lsof.sh",
}
